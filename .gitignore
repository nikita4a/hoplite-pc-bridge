# ── hoplite-pc-bridge ──
# Deny-all allowlist: nothing is committed unless named here.
# This repo tunnels SHELL ACCESS to the public internet — a leaked
# config.json or ngrok.yml is a remote-code-execution handover.
*
!.gitignore
!.gitattributes
!*.md
!*.py
!*.bat
!config.example.json
!docs/
!tools/

# ...but never caches, local state, or credentials — even inside allowlisted dirs
__pycache__/
*.pyc
*.log
status.json
config.json
ngrok.yml
ngrok-agent.yml

# subagent scratch — never publish
_*
tools/_*
